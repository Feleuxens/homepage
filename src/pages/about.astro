---
// About as an athlete profile. Facts instead of self-ratings, and the career as a
// race over the three lanes: one row per lane, bars spanning the years.
import MainLayout from "../layouts/MainLayout.astro";
import Portrait from "../components/Portrait.astro";
import { CAREER, INSTRUMENTS_LINE } from "../data/career";
import { pianoHighlights } from "../data/repertoire";

const now = new Date().getFullYear();
const START = 2008;
const years = Array.from({ length: now - START + 1 }, (_, i) => START + i);

type Entry = { from: number; to?: number; title: string; org?: string; note?: string; point?: boolean };
type Lane = { n: number; name: string; entries: Entry[] };

const lanes: Lane[] = [
  {
    n: 1, name: "IT",
    entries: [
      { from: CAREER.studyFrom, to: CAREER.bachelorUntil, title: "B.Sc. Computer Science", org: "University of Stuttgart" },
      { from: CAREER.workFrom, title: "Working student, DevOps & SysAdmin", org: "intension GmbH" },
      { from: CAREER.masterFrom, title: "M.Sc. Computer Science", org: "University of Stuttgart" },
      { from: CAREER.architectCertificate, point: true, title: "iSAQB CPSA-F", org: "Certified Software Architect", note: "Basic concepts of software architecture, requirements and constraints, design and development." },
    ],
  },
  {
    n: 2, name: "Music",
    entries: [
      { from: CAREER.trumpetFrom, to: CAREER.trumpetLessonsUntil, title: "Trumpet lessons" },
      { from: CAREER.pianoFrom, to: CAREER.pianoLessonsUntil, title: "Piano lessons" },
      { from: CAREER.liveFrom, title: "Live performances", org: "Weddings, memorials" },
      { from: CAREER.musicExam, point: true, title: "Music exam, A-levels", note: "Clarke Suite in D major, Rachmaninoff Prelude in C♯ minor, Neruda Trumpet Concerto in E♭ major: I. Allegro." },
    ],
  },
  {
    n: 3, name: "Photography",
    entries: [
      { from: CAREER.photographyFrom, title: "Photography", org: "Sport, drone, portraits" },
    ],
  },
];

// Stack overlapping bars into sub-rows so nothing collides
const positioned = lanes.map(lane => {
  const rowsEnd: number[] = [];
  const items = [...lane.entries].sort((a, b) => a.from - b.from).map(e => {
    const end = e.point ? e.from : (e.to ?? now);
    let row = rowsEnd.findIndex(r => r < e.from);
    if (row === -1) { row = rowsEnd.length; rowsEnd.push(end); } else rowsEnd[row] = end;
    const colStart = e.from - START + 1;
    const colEnd = (e.point ? e.from : (e.to ?? now)) - START + 2;
    return { ...e, row: row + 1, colStart, colEnd, ongoing: !e.point && e.to === undefined };
  });
  return { ...lane, items, rows: rowsEnd.length };
});

const track = [
  { label: "Club", value: "LG Filder" },
  { label: "Main event", value: "800 m" },
  { label: "Coaching", value: "U14 and U16" },
  { label: "Licence", value: "C-Trainer Lizenz" },
];

const instruments = [
  {
    name: "Piano", since: CAREER.pianoFrom,
    text: "Classical and contemporary repertoire, with a focus on performance and music theory.",
    pieces: pianoHighlights,
  },
  {
    name: "Trumpet", since: CAREER.trumpetFrom,
    text: "Classical trumpet in several orchestras, solo performances and competitions.",
    pieces: ["Neruda · Trumpet Concerto in E♭: I. Allegro", "Bach · Christmas Oratorio: Großer Herr und starker König", "Albinoni · Concerto in B♭, Op. 7 No. 3: I. Allegro"],
  },
  {
    name: "Theory & craft", since: CAREER.theoryFrom,
    text: "Music theory, sight reading, arrangement and transcription.",
    pieces: [],
  },
];
---

<MainLayout title="About Me" lane={0}
  description="About Felix Grüb: computer science, DevOps and system administration, piano and trumpet, photography, and track and field.">

  <div class="ab">
    <!-- Profile -->
    <section class="profile wrap">
      <Portrait widths={[400, 700, 1000]} sizes="(min-width: 960px) 32vw, 80vw" loading="eager" />

      <div class="intro">
        <p class="eyebrow">About · athlete profile</p>
        <h1>Hello, I'm <em class="accent">Felix.</em></h1>
        <p class="lede">
          I'm a computer science student interested in cryptography and system and web security.
          When I'm not working on infrastructure, you'll find me at the piano, on the track, or behind
          a camera. Technical precision and creative expression turn out to complement each other,
          whether it's debugging a pipeline or practising a Rachmaninoff prelude.
        </p>

        <dl class="card">
          <div><dt>Based in</dt><dd>Filderstadt, near Stuttgart</dd></div>
          <div><dt>Studying</dt><dd>M.Sc. Computer Science, University of Stuttgart <span class="tag-live">in progress</span></dd></div>
          <div><dt>Working</dt><dd>DevOps &amp; system administration, intension GmbH, since {CAREER.workFrom}</dd></div>
          <div><dt>Playing</dt><dd>{INSTRUMENTS_LINE}</dd></div>
          <div><dt>Shooting</dt><dd>Sports photography since {CAREER.photographyFrom}</dd></div>
          <div><dt>Running</dt><dd>Track &amp; field athlete and youth coach</dd></div>
        </dl>
      </div>
    </section>

    <!-- Career as a race over the lanes -->
    <section class="race on-track">
      <div class="wrap">
        <p class="eyebrow light">Race history</p>
        <h2>Three lanes, one race.</h2>
        <p class="race-sub">Every bar is something I did; bars that run off the right edge are still going.</p>
      </div>

      <div class="race-track" role="list" aria-label="Timeline">
        <div class="years" aria-hidden="true" style={`--cols:${years.length}`}>
          <span class="lane-label"></span>
          {years.map(y => <span class:list={["yr", { major: y % 4 === 0 || y === now }]}>{y % 4 === 0 || y === now ? y : ""}</span>)}
        </div>
        {positioned.map(lane => (
          <div class="race-lane" style={`--cols:${years.length}; --rows:${lane.rows}`} role="listitem" aria-label={`Lane ${lane.n}: ${lane.name}`}>
            <span class="lane-label"><span class="chip chip-white lane-block">{lane.n}</span><span class="lane-name">{lane.name}</span></span>
            <ul class="bars list-reset">
              {lane.items.map(e => (
                <li class:list={["bar", { point: e.point, ongoing: e.ongoing }]}
                    style={`--col:${e.colStart} / ${e.colEnd}; --row:${e.row}`}
                    title={e.note}>
                  <span class="bar-title">{e.title}</span>
                  <span class="bar-meta">{e.point ? e.from : `${e.from}–${e.to ?? "now"}`}{e.org ? ` · ${e.org}` : ""}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Skills -->
    <section class="skills wrap">
      <div class="sk-track">
        <p class="eyebrow">Track &amp; field</p>
        <h2>Two laps, mostly.</h2>
        <table>
          <tbody>
            {track.map(t => (
              <tr><th scope="row">{t.label}</th><td>{t.value}</td></tr>
            ))}
          </tbody>
        </table>
        <h3>What else?</h3>
        <p class="reading">When I'm not on the track, I enjoy reading books on technology, mathematics, physics and psychology.</p>
      </div>

      <div class="sk-music">
        <p class="eyebrow">Music</p>
        <h2>Instruments.</h2>
        <ul class="inst list-reset">
          {instruments.map(i => (
            <li>
              <p class="inst-head"><strong>{i.name}</strong><span>since {i.since}</span></p>
              <p class="inst-text">{i.text}</p>
              {i.pieces.length > 0 && <ul class="inst-pieces list-reset list-notes">{i.pieces.map(p => <li>{p}</li>)}</ul>}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="ab-cta on-ink">
      <div class="checker" aria-hidden="true"></div>
      <div class="wrap ab-cta-inner">
        <h2>Want to work together?</h2>
        <p>A technical challenge or a musical performance: I'm open to both.</p>
        <a href="/contact" class="btn btn-paper btn-lg">Get in touch</a>
      </div>
    </section>
  </div>
</MainLayout>

<style>
  h1, h2, h3 { font-family: var(--serif); font-weight: 600; margin: 0; letter-spacing: -.02em; }
  h2 { font-size: clamp(2.2rem, 4.5vw, 3.6rem); line-height: 1.02; margin-bottom: var(--space-5); }

  /* Profile */
  .profile { --portrait-max: 42rem; display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; padding-block: clamp(2.5rem, 6vw, 5rem); }
  .intro h1 { font-size: clamp(3rem, 7vw, 6rem); line-height: .95; letter-spacing: -.04em; margin-bottom: var(--space-6); }
  .lede { font: 400 clamp(1.1rem, 1.6vw, 1.3rem)/1.55 var(--serif); max-width: 40rem; margin: 0 0 var(--space-8); }
  .card { margin: 0; border-top: 3px solid var(--page-fg); }
  .card div { display: grid; grid-template-columns: 7.5rem 1fr; gap: var(--space-4); padding: .7rem 0; border-bottom: 1px solid var(--page-line); }
  .card dt { font: var(--text-xs)/1.6 var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--track-text); }
  .card dd { margin: 0; font-size: .97rem; }
  .tag-live { display: inline-block; margin-left: .4rem; padding: .05rem .45rem; border-radius: 999px; border: 1px solid var(--track); color: var(--track-text); font: .68rem/1.5 var(--mono); text-transform: uppercase; letter-spacing: .05em; vertical-align: .1em; }
  @media (max-width: 860px) { .profile { --portrait-max: 26rem; grid-template-columns: 1fr; } }

  /* Race history */
  .race { padding-block: clamp(4rem, 8vw, 6rem); }
  .race .eyebrow.light { color: var(--on-accent-dim); }
  .race-sub { margin: 0 0 var(--space-10); color: var(--on-accent-dim); }
  .race-track { max-width: 82rem; margin-inline: auto; padding-inline: var(--pad); overflow-x: auto; }
  .years, .race-lane { display: grid; grid-template-columns: 9rem 1fr; min-width: 52rem; }
  .years { grid-template-columns: 9rem repeat(var(--cols), 1fr); font: .72rem/1 var(--mono); color: var(--on-accent-dim); padding-bottom: var(--space-2); }
  .yr { border-left: 1px solid rgba(255, 255, 255, .25); padding-left: .3rem; height: 1rem; }
  .race-lane { border-top: 3px solid var(--on-accent); padding-block: .9rem; }
  .race-lane:last-child { border-bottom: 3px solid var(--on-accent); }
  .lane-label { display: flex; align-items: center; gap: .7rem; }
  .lane-block { --chip-size: 2.4rem; border-radius: .3rem; font-size: 1.3rem; box-shadow: 0 3px 0 rgba(0, 0, 0, .18); }
  .lane-name { font: 600 1.15rem/1 var(--serif); }
  .bars { display: grid; grid-template-columns: repeat(var(--cols), 1fr); grid-template-rows: repeat(var(--rows), auto); gap: .4rem 0; }
  .bar { grid-column: var(--col); grid-row: var(--row); position: relative; min-width: 0; margin-right: 2px; padding: .45rem .6rem; background: var(--on-accent); color: var(--page-fg); border-radius: 3px; box-shadow: 0 2px 0 rgba(0, 0, 0, .15); overflow: hidden; }
  .bar.ongoing { border-radius: 3px 0 0 3px; margin-right: 0; background: linear-gradient(90deg, var(--on-accent) 85%, rgba(255, 255, 255, .55)); }
  .bar.ongoing::after { content: "→"; position: absolute; right: .4rem; top: 50%; translate: 0 -50%; color: var(--track); font-weight: 700; }
  .bar.point { background: var(--page-fg); color: var(--on-accent); width: max-content; max-width: 16rem; overflow: visible; z-index: 1; }
  .bar.point .bar-meta { color: rgba(255, 255, 255, .7); }
  .bar-title { display: block; font-weight: 600; font-size: var(--text-sm); line-height: 1.2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar-meta { display: block; font: .68rem/1.4 var(--mono); color: var(--page-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (max-width: 760px) {
    /* Phones: the lanes become a stacked list instead of a scrolling chart */
    .years { display: none; }
    .years, .race-lane { min-width: 0; }
    .race-lane { grid-template-columns: 1fr; gap: var(--space-3); }
    .bars { display: flex; flex-direction: column; gap: .4rem; }
    .bar, .bar.point { width: auto; max-width: none; }
    .bar-title, .bar-meta { white-space: normal; }
  }

  /* Skills */
  .skills { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.5rem, 6vw, 6rem); padding-block: clamp(4.5rem, 9vw, 7rem); }
  .sk-track table { width: 100%; border-collapse: collapse; margin-bottom: var(--space-7); border-top: 3px solid var(--page-fg); }
  .sk-track th, .sk-track td { text-align: left; padding: var(--space-3) 0; border-bottom: 1px solid var(--page-line); vertical-align: top; }
  .sk-track th { width: 8rem; font: var(--text-xs)/1.9 var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--track-text); font-weight: 400; }
  .sk-track h3 { margin-bottom: var(--space-2); font-size: 1.6rem; }
  .reading { margin: 0; color: var(--page-fg-2); }
  .inst { border-top: 3px solid var(--page-fg); }
  .inst > li { padding: var(--space-4) 0; border-bottom: 1px solid var(--page-line); }
  .inst-head { display: flex; justify-content: space-between; align-items: baseline; margin: 0 0 .35rem; }
  .inst-head strong { font: 600 1.3rem/1.2 var(--serif); }
  .inst-head span { font: italic 400 var(--text-md)/1 var(--serif); color: var(--page-dim); }
  .inst-text { margin: 0 0 var(--space-2); color: var(--page-fg-2); font-size: .97rem; }
  .inst-pieces { font: italic 400 .93rem/1.6 var(--serif); color: var(--page-dim); }
  @media (max-width: 900px) { .skills { grid-template-columns: 1fr; } }

  /* CTA */
  .ab-cta-inner { padding-block: clamp(4rem, 8vw, 6rem); text-align: center; }
  .ab-cta p { color: var(--inverse-dim); margin: 0 0 var(--space-8); }
</style>
