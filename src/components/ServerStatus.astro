---
// Measured facts about the server behind this site. Used as a server island (server:defer),
// with `pending` for the placeholder, so both states take up the same space.
// Lay it out from the parent through --facts-columns.
import { formatAgo, formatDuration, getServerStatus } from "../lib/server-status";

interface Props {
  pending?: boolean;
}
const { pending = false } = Astro.props;
const status = pending ? null : await getServerStatus();
---
<dl class="facts">
  <div>
    <dt>Server up for</dt>
    <dd class="mono">{status ? formatDuration(status.uptimeSeconds) : "…"}</dd>
  </div>
  <div>
    <dt>Latest image built</dt>
    <dd class="mono">
      {!status ? "…" : status.imageBuilt
        ? <time datetime={status.imageBuilt.toISOString()}>{formatAgo(status.imageBuilt)}</time>
        : "not available"}
    </dd>
  </div>
</dl>

<style>
  .facts { display: grid; grid-template-columns: var(--facts-columns, 1fr); gap: var(--space-2) var(--space-8); margin: 0; font-size: var(--text-md); }
  .facts div { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0 var(--space-4); }
  dt { color: var(--page-fg-2); }
  dd { margin: 0; color: var(--ok); }
</style>
