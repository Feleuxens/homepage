---
import { exifData } from "../data/exif-data";
import SquareImage from "./SquareImage.astro";

interface Props {
    sortBy?: 'date' | 'filename' | 'random';
    maxImages?: number;
}

const {
    sortBy = 'date',
    maxImages,
} = Astro.props;

let folder = "/images/photography/favorites/";
const imageModules = import.meta.glob('../../public/images/photography/favorites/*.{jpg,jpeg,png,webp,JPG}');
const images = await Promise.all(
    Object.entries(imageModules).map(async ([path, importFn]) => {
        const module = await importFn();
        const filename = path.split('/').pop() || '';
        const imageExif = exifData["public" + folder + filename] || {};
        const aspectRatio = imageExif.aspectRatio;
        return {
            src: module.default,
            filename,
            path,
            aspectRatio,
            // Extract date for sorting
            date: imageExif.dateIso
                ? Date.parse(imageExif.dateIso)
                : new Date(0) // fallback to epoch if no date
        }
    })
);

// Sort images based on sortBy prop
let sortedImages = [...images];
switch (sortBy) {
    case 'date':
    sortedImages.sort((a, b) => b.date - a.date); // newest first
    break;
    case 'filename':
    sortedImages.sort((a, b) => a.filename.localeCompare(b.filename));
    break;
    case 'random':
    sortedImages.sort(() => Math.random() - 0.5);
    break;
}
const displayImages = maxImages ? sortedImages.slice(0, maxImages) : sortedImages;

// Assumes every image is 3:2 or 2:3
function cell(index: number, aspectRatio?: number) {
    const isPortrait = aspectRatio != null && aspectRatio > 1;

    // size is rendered size
    if (isPortrait) return { cols: 6, rows: 8, size: 900 }; // 2:3, slightly cropped to match layout
    if (index === 0 || index % 4 === 0) return { cols: 12, rows: 8, size: 1600 }; // full 3:2
    return { cols: 6, rows: 4, size: 600 }; // 3:2
}

---
<div class="masonry-wrap">
    <div class="masonry-grid ">
    {
        displayImages.map((image, index) => {
            const { cols, rows, size } = cell(
                index,
                image.aspectRatio
            );
            return (
                    <div
                            class="masonry-item group overflow-hidden rounded-lg"
                            style={`grid-column: span ${cols}; grid-row: span ${rows};`}
                    >
                        <SquareImage
                                src={image.src}
                                alt={`Photo ${index + 1}`}
                                path={`${folder}${image.filename}`}
                                size={size}
                        />
                    </div>
            );
        })
    }
    </div>

</div>

<style>
    /* Establishes the width reference for cqw below. */
    .masonry-wrap {
        container-type: inline-size;
    }

    .masonry-grid {
        --cols: 18;
        --gap: 0.5rem;
        display: grid;
        grid-template-columns: repeat(var(--cols), 1fr);
        /* Row height == column width, so cells are square and 3:2 / 2:3
           spans are exact. cqw tracks the wrapper's width responsively. */
        grid-auto-rows: calc(
                (100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols)
        );
        grid-auto-flow: dense;
        gap: var(--gap);
    }

    .masonry-item :global(button),
    .masonry-item :global(img) {
        width: 100%;
        height: 100%;
    }

    @media (prefers-reduced-motion: no-preference) {
        .masonry-item :global(img) {
            transition: transform 0.5s ease;
        }
    }
</style>

