---
// Pipeline job status: a tick when done, a ring while running.
// Parents set the size through --job-icon-size and --job-icon-font.
interface Props {
  running?: boolean;
  /** Turn the ring. Off for small previews. */
  spin?: boolean;
}
const { running = false, spin = false } = Astro.props;
---
<span class:list={["icon", { running, spin }]} aria-hidden="true">{running ? "" : "✓"}</span>

<style>
  .icon { display: inline-grid; place-items: center; flex: none; width: var(--job-icon-size, 1.3rem); height: var(--job-icon-size, 1.3rem); border-radius: 50%; background: var(--ok); color: var(--on-accent); font-size: var(--job-icon-font, var(--text-xs)); font-weight: 700; }
  .running { background: transparent; border: 2px solid var(--info); border-right-color: transparent; }
  @media (prefers-reduced-motion: no-preference) {
    .running.spin { animation: spin 1s linear infinite; }
  }
</style>
