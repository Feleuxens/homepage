---
// Homepage "Three Lanes". Each lane leads to a page with its own world:
// 1 IT = monitoring dashboard, 2 Music = sheet music, 3 Photography = viewfinder.
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import Panel from "../components/Panel.astro";
import Portrait from "../components/Portrait.astro";
import ProgrammeList from "../components/ProgrammeList.astro";
import ServerStatus from "../components/ServerStatus.astro";
import Status from "../components/Status.astro";
import JobIcon from "../components/JobIcon.astro";
import PhotoCredit from "../components/PhotoCredit.astro";
import heroImg from "../../public/images/hero-bg.jpg";
import pianoImg from "../../public/images/wedding1.jpg";
import photographerImg from "../../public/images/photographer2.jpg";
import { getFavoritePhotos, newestFirst, photoSettings, FAVORITES_FOLDER } from "../lib/favorites";
import { CAREER } from "../data/career";
import { pipeline } from "../data/pipeline";
import { programmeExcerpt } from "../data/repertoire";
import { services } from "../data/services";
import { exifData } from "../data/exif-data";
import { EMAIL, LANES, SOCIAL } from "../lib/site";

const favorites = getFavoritePhotos()
  .sort(newestFirst)
  .slice(0, 8)
  .map(photo => ({ ...photo, meta: photoSettings(exifData["public" + FAVORITES_FOLDER + photo.filename] ?? {}) }));

// The lanes come from site.ts; the homepage adds a pitch and one fact for each
const lanes = [
  { ...LANES[0], pitch: "DevOps, system administration, containers and software architecture. Kept boring, on purpose.", meta: `Since ${CAREER.studyFrom}` },
  { ...LANES[1], title: "Live Music", pitch: "Piano or trumpet for weddings, memorials and celebrations. Plus arrangements.", meta: `Since ${CAREER.trumpetFrom}` },
  { ...LANES[2], pitch: "Competitive sport first. Also drone, portraits, and the occasional commission.", meta: "Canon R6 III" },
];

// Sneak peeks: each is a subset of what the lane's own page shows

const movements = ["Weddings", "Memorials", "Arrangements", "Transcription"];
const totalFavourites = getFavoritePhotos().length;

const splits = [
  { year: CAREER.trumpetFrom, label: "First trumpet lesson" },
  { year: CAREER.pianoFrom, label: "First piano lesson" },
  { year: CAREER.studyFrom, label: "Started B.Sc. Computer Science, Stuttgart" },
  { year: CAREER.workFrom, label: "Working student, DevOps & SysAdmin" },
  { year: CAREER.masterFrom, label: "Started M.Sc. Computer Science" },
  { year: CAREER.architectCertificate, label: "iSAQB Certified Software Architect" },
];
---

<MainLayout title="Home" lane={0} description="Felix Grüb: IT services and consulting, live music on piano and trumpet, and sports photography.">
    <!-- HERO -->
    <section class="hero">
      <div>
        <h1 class="rise" style="--i:1">Felix<br /><em class="accent">Grüb</em></h1>
        <p class="lede rise" style="--i:2">
          Computer science student near Stuttgart. I run servers, play piano and trumpet at
          weddings, and photograph track meets.
        </p>
        <div class="rise hero-cta" style="--i:3">
          <a href="#lanes" class="btn btn-ink btn-lg">Pick a lane <span aria-hidden="true">↓</span></a>
          <a href="/contact" class="link-arrow">Or just say hello</a>
        </div>
      </div>

      <figure class="hero-photo rise" style="--i:1">
        <Image
          src={heroImg}
          alt="Sprinters exploding out of the starting blocks on a red track"
          widths={[640, 960, 1400]}
          sizes="(min-width: 960px) 46vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="photo-label"><span class="hero-tag">On your marks · </span><PhotoCredit by="silas" /></figcaption>
      </figure>
    </section>

    <!-- THE TRACK: three lanes as the main navigation -->
    <section id="lanes" class="track on-track" aria-label="What I do">
      {lanes.map(l => (
        <a href={l.href} class="lane">
          <span class="chip chip-white lane-block" aria-hidden="true">{l.n}</span>
          <span class="lane-title">{l.title}</span>
          <span class="lane-pitch">{l.pitch}</span>
          <span class="lane-meta">{l.meta}</span>
          <span class="lane-arrow" aria-hidden="true">→</span>
          <span class="lane-sprint" aria-hidden="true"></span>
        </a>
      ))}
    </section>

    <!-- LANE 1: one wide dashboard panel, the heading above it -->
    <section id="infrastructure" class="it wrap">
      <div class="it-head">
        <h2>Infrastructure that stays boring.</h2>
        <div>
          <p class="body">
            I've worked in DevOps since {CAREER.workFrom} and run my own server. That means regular updates, deploying
            services in Docker containers and working out why something broke. Nothing too exciting, which is the point.
          </p>
          <a href="/tech-services" class="link-arrow">Open the dashboard</a>
        </div>
      </div>

      <Panel as="div" flush title="Service status" class="it-panel">
        <Status slot="status">All available</Status>
        <ul class="svc-grid list-reset">
          {services.map(s => (
            <li><strong>{s.title}</strong><span>{s.short}</span><Status>available</Status></li>
          ))}
        </ul>
        <div class="it-foot">
          <ServerStatus server:defer><ServerStatus slot="fallback" pending /></ServerStatus>
          <div class="mini-pipe" aria-label="Project process">
            {pipeline.map(p => (
              <span class="mini-job"><JobIcon />{p.stage}</span>
            ))}
          </div>
        </div>
      </Panel>
    </section>

    <!-- LANE 2: the photo runs off the page, the programme is printed on the paper next to it -->
    <section id="music" class="music">
      <figure class="music-photo">
        <Image src={pianoImg} alt="Hands on a piano at a wedding reception" widths={[640, 960, 1400]} sizes="(min-width: 960px) 55vw, 100vw" />
        <figcaption class="photo-label"><PhotoCredit by="oliver" /></figcaption>
      </figure>

      <div class="music-text">
        <h2>For the moments you only get once.</h2>
        <ol class="mv-line list-reset">
          {movements.map((m, i) => <li><span>{["I", "II", "III", "IV"][i]}.</span> {m}</li>)}
        </ol>
        <h3 class="programme-head">Programme excerpt</h3>
        <p class="programme-sub">A few pieces from the full repertoire.</p>
        <ProgrammeList items={programmeExcerpt} class="programme-rows" />
        <a href="/music#programme" class="link-arrow">See the full programme</a>
      </div>
    </section>

    <!-- LANE 3: the whole section is the camera's screen, edge to edge -->
    <section id="photography" class="photo">
      <div class="photo-head">
        <h2>Fast things, held still.</h2>
        <p class="pb-count mono" aria-hidden="true"><span>▶ Playback</span> {favorites.length + 1} / {totalFavourites + 1}</p>
      </div>
      <div class="sheet" tabindex="0" aria-label="Recent favourite photographs, scroll horizontally">
        <figure class="frame frame-self">
          <Image src={photographerImg} alt="Felix photographing at the indoor track and field championships" widths={[480, 800]} sizes="clamp(21rem, 60vh, 36rem)" />
          <figcaption class="mono"><span>000</span>Behind the lens</figcaption>
        </figure>
        {favorites.map((p, i) => (
          <figure class="frame">
            <Image src={p.src} alt="" widths={[480, 800]} sizes="clamp(21rem, 60vh, 36rem)" loading="lazy" />
            <figcaption class="mono"><span>{String(i + 1).padStart(3, "0")}</span>{p.meta}</figcaption>
          </figure>
        ))}
        <a href="/photography#favourites" class="frame frame-more"><span class="mono">+{totalFavourites - favorites.length} more</span><span>See all →</span></a>
      </div>
      <div class="photo-foot">
        <p>
          As an athlete myself I know where the moment is going to happen, and I'm usually
          already lying on the floor next to it. Mostly passion, also available for commissions.
        </p>
        <a href="/photography" class="link-arrow">Open the viewfinder</a>
      </div>
    </section>

    <!-- ABOUT: portrait and a results sheet -->
    <section id="about" class="about wrap">
      <Portrait widths={[400, 700]} sizes="(min-width: 960px) 30vw, 70vw" />
      <div>
        <h2>Computer science, a piano and 800 metres.</h2>
        <p class="body">
          I study computer science with an interest in cryptography and system and web security, work in DevOps,
          and spend the rest of my time at the piano, on the track or behind a camera. Debugging
          infrastructure and practising Rachmaninoff turn out to need the same patience.
        </p>
        <a href="/about" class="link-arrow">The longer version</a>
        <ol class="splits list-reset" aria-label="Split times">
          {splits.map(s => (
            <li><span class="split-year">{s.year}</span><span>{s.label}</span></li>
          ))}
        </ol>
      </div>
    </section>

    <!-- FINISH -->
    <section class="finish on-ink">
      <div class="checker" aria-hidden="true"></div>
      <div class="wrap finish-inner">
        <h2>Got something that&nbsp;<br />needs doing?</h2>
        <a href={`mailto:${EMAIL}`} class="mail">{EMAIL}</a>
        <div class="finish-cta">
          <a href="/contact" class="btn btn-paper btn-lg">Use the contact form</a>
          {SOCIAL.map(l => <a href={l.href} class="link-arrow">{l.name}</a>)}
        </div>
      </div>
    </section>
</MainLayout>

<style>
  h1, h2 { font-family: var(--serif); font-weight: 600; margin: 0; letter-spacing: -.02em; text-wrap: balance; }
  .body { max-width: 38rem; color: var(--page-fg-2); font-size: 1.125rem; margin: 0 0 var(--space-5); }
  /* A flowing space keeps the arrow off the last letter */
  .link-arrow::after { margin-left: .25em; }
  .photo-label { font-size: var(--text-xs); }

  /* Hero */
  .hero {
    display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(2rem, 5vw, 5rem);
    align-items: end;
    padding: clamp(3rem, 8vw, 6rem) var(--pad) clamp(3rem, 6vw, 5rem);
    max-width: 92rem; margin-inline: auto;
  }
  .hero h1 { font-size: clamp(4.5rem, 13vw, 12rem); line-height: .86; letter-spacing: -.045em; margin-bottom: 2.25rem; }
  .hero h1 em { padding-left: .4em; }
  .lede { font: 400 clamp(1.25rem, 2vw, 1.6rem)/1.4 var(--serif); max-width: 32rem; margin: 0 0 var(--space-10); }
  .hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-7); }
  .hero-photo { margin: 0; position: relative; aspect-ratio: 4 / 5; overflow: hidden; }
  .hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 35% 50%; }
  @media (max-width: 22rem) { .hero-tag { display: none; } }
  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; }
    .hero-photo { aspect-ratio: 3 / 2; order: -1; }
  }

  /* Track: three lanes */
  .track { border-block: 3px solid var(--on-accent); }
  .lane {
    position: relative; overflow: hidden;
    display: grid; grid-template-columns: auto minmax(10rem, 1fr) 2fr auto auto;
    align-items: center; gap: clamp(1rem, 3vw, 3rem);
    padding: clamp(1.5rem, 3.5vw, 2.75rem) var(--pad);
    text-decoration: none;
    border-bottom: 3px solid var(--on-accent);
  }
  .lane:last-child { border-bottom: 0; }
  .lane-block { --chip-size: clamp(3rem, 5vw, 4.25rem); border-radius: .35rem; font-size: clamp(1.6rem, 3vw, 2.4rem); }
  .lane-title { font: 600 clamp(1.75rem, 3.5vw, 3rem)/1 var(--serif); letter-spacing: -.02em; }
  .lane-pitch { color: var(--on-accent-dim); max-width: 34rem; }
  .lane-meta { color: var(--on-accent-dim); white-space: nowrap; font-size: var(--text-sm); }
  .lane-arrow { font-size: 1.75rem; transition: translate .3s var(--ease); }
  .lane-sprint {
    position: absolute; left: 0; right: 0; bottom: 0; height: 3px;
    background: var(--page-fg); transform: scaleX(0); transform-origin: left;
    transition: transform .6s var(--ease);
  }
  .lane:hover { background: var(--track-deep); }
  .lane:hover .lane-arrow { translate: 8px 0; }
  .lane:hover .lane-sprint { transform: scaleX(1); }
  @media (max-width: 860px) {
    .lane { grid-template-columns: auto 1fr auto; }
    .lane-pitch { grid-column: 2 / -1; grid-row: 2; }
    .lane-meta { display: none; }
  }

  /* Lane 1: heading above one wide panel */
  .it { padding-block: clamp(5rem, 11vw, 8.5rem); }
  .it-head { display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--space-8) clamp(2.5rem, 6vw, 6rem); align-items: end; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .it h2 { font: 700 clamp(2.4rem, 5vw, 4.2rem)/1 var(--sans); letter-spacing: -.035em; }
  .svc-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .svc-grid li { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-1); padding: var(--space-5) 1.1rem; border-right: 1px solid var(--surface-line); border-bottom: 1px solid var(--surface-line); }
  .svc-grid li:last-child { border-right: 0; }
  .svc-grid strong { font-weight: 600; font-size: var(--text-base); line-height: 1.3; }
  .svc-grid span:not([class*="status"]) { margin-bottom: var(--space-2); font-size: var(--text-sm); color: var(--page-dim); }
  .it-foot { --facts-columns: auto auto; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-4) var(--space-8); padding: var(--space-4) 1.1rem; }
  .mini-pipe { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .mini-job { --job-icon-size: 1.1rem; display: inline-flex; align-items: center; gap: .45rem; padding: .35rem var(--space-3) .35rem .4rem; border: 1px solid var(--surface-line); border-radius: 999px; background: var(--surface-2); font: .78rem/1 var(--mono); }
  .mini-job:not(:last-child)::after { content: "→"; margin-left: var(--space-2); color: var(--page-dim); }
  @media (max-width: 960px) {
    .it-head { grid-template-columns: 1fr; }
    .svc-grid { grid-template-columns: 1fr 1fr; }
    .svc-grid li:nth-child(even) { border-right: 0; }
  }
  @media (max-width: 560px) {
    .svc-grid { grid-template-columns: 1fr; }
    .svc-grid li { border-right: 0; }
    .it-foot { --facts-columns: 1fr; }
    .it-foot > * { width: 100%; }
  }

  /* Lane 2: photo off the left edge, the programme printed on the paper */
  .music { display: grid; grid-template-columns: 1.25fr 1fr; align-items: stretch; background: var(--surface); }
  .music-photo { position: relative; margin: 0; min-height: 100%; }
  .music-photo img { width: 100%; height: 100%; min-height: 34rem; object-fit: cover; }
  .music-text { padding: clamp(3rem, 6vw, 6rem) var(--pad); align-self: center; max-width: 42rem; }
  .music h2 { font-size: clamp(2.2rem, 4vw, 3.75rem); line-height: 1.04; margin-bottom: var(--space-5); }
  .mv-line { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-bottom: var(--space-8); font: italic 400 1.1rem/1.4 var(--serif); color: var(--score-dim); }
  .mv-line span { font-style: normal; font-weight: 700; color: var(--score-red); }
  .programme-head { margin: 0; font: 600 var(--text-xl)/1.2 var(--serif); }
  .programme-sub { margin: var(--space-1) 0 var(--space-4); font: italic 400 var(--text-base)/1.4 var(--serif); color: var(--score-dim); }
  .programme-rows { --list-margin: 0 0 var(--space-8); --row-pad: .4rem 0; --row-size: 1.05rem; }
  @media (max-width: 960px) {
    .music { grid-template-columns: 1fr; }
    .music-photo img { min-height: 0; aspect-ratio: 3 / 2; }
  }

  /* Lane 3: the section is the screen */
  .photo { padding-block: clamp(3.5rem, 7vw, 6rem); background: var(--screen-bg); color: var(--screen-text); }
  .photo-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-3) var(--space-8); padding-inline: var(--pad); margin-bottom: var(--space-8); }
  .photo h2 { font: 800 clamp(2.6rem, 7vw, 6.5rem)/.95 var(--sans); letter-spacing: -.04em; }
  .pb-count { margin: 0; color: var(--screen-dim); }
  .pb-count span { color: var(--hud-ok); }
  .sheet {
    display: flex; gap: var(--space-4); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--pad);
    padding: var(--space-2) var(--pad) var(--space-4);
    scrollbar-color: var(--screen-scrollbar) transparent;
  }
  .sheet:focus-visible { outline-color: var(--screen-text); outline-offset: -2px; }
  .frame { margin: 0; flex: 0 0 auto; scroll-snap-align: start; outline: 2px solid transparent; outline-offset: 3px; transition: outline-color .15s; }
  .frame img { height: clamp(16rem, 58vh, 36rem); width: auto; object-fit: cover; }
  /* Hovering one frame drains the others. Only with a real pointer, so it can't stick after a tap. */
  @media (hover: hover) {
    .frame img { transition: filter .3s; }
    .sheet:hover .frame img { filter: grayscale(.6) brightness(.7); }
    .sheet .frame:hover img { filter: none; }
    .sheet .frame:hover { outline-color: var(--hud); }
  }
  .frame figcaption { margin-top: .6rem; color: var(--screen-caption); display: flex; gap: var(--space-3); text-transform: none; }
  .frame figcaption span { color: var(--hud); }
  .frame-self img { aspect-ratio: 3/2; }
  .frame-more { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: .6rem; width: 14rem; height: clamp(16rem, 58vh, 36rem); background: var(--screen-bg-2); text-decoration: none; color: var(--screen-text); transition: background-color .2s; }
  .frame-more:hover { background: var(--screen-hover); }
  .frame-more .mono { color: var(--hud); }
  /* Phones: the first frame fits the screen, the next one shows at the edge */
  @media (max-width: 600px) { .frame img, .frame-more { height: 14.5rem; } }
  .photo-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--space-5) var(--space-8); padding: var(--space-6) var(--pad) 0; }
  .photo-foot p { max-width: 38rem; margin: 0; font-size: 1.125rem; color: var(--screen-fg); }
  .photo-foot .link-arrow { white-space: nowrap; }
  .photo-foot :focus-visible, .frame-more:focus-visible { outline-color: var(--screen-text); }

  /* About */
  .about { --portrait-max: 38rem; display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; padding-block: clamp(5rem, 11vw, 9rem); }
  .about h2 { font-size: clamp(2.4rem, 4vw, 3.75rem); line-height: 1.04; margin-bottom: var(--space-6); font-variant-numeric: lining-nums; }
  .splits { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--space-8); margin-top: var(--space-10); border-top: 3px solid var(--page-fg); }
  .splits li { display: grid; grid-template-columns: 3.25rem 1fr; gap: var(--space-3); padding: .8rem 0; font-size: var(--text-md); }
  .split-year { font-weight: 600; font-variant-numeric: tabular-nums; color: var(--track-text); }
  @media (max-width: 860px) {
    .about { --portrait-max: 24rem; grid-template-columns: 1fr; }
    .splits { grid-template-columns: 1fr; }
  }

  /* Finish */
  .finish-inner { padding-block: clamp(5rem, 10vw, 8rem); }
  .finish h2 { font-size: clamp(2.8rem, 7vw, 6.5rem); line-height: 1.02; margin-bottom: var(--space-6); }
  @media (max-width: 600px) { .finish h2 br { display: none; } }
  .mail {
    display: inline-block; font: 500 clamp(1.5rem, 4vw, 3rem)/1.1 var(--serif); font-style: italic;
    text-decoration: none; color: var(--inverse-accent); margin-bottom: var(--space-10);
    overflow-wrap: anywhere;
  }
  .mail:hover { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .15em; }
  .finish-cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-6) var(--space-8); }
  .finish-cta .link-arrow { color: var(--inverse-link); }
  .finish :focus-visible { outline-color: var(--inverse-fg); }

  /* Motion: the hero flies in on load, and when the track comes into view a runner goes through each lane once */
  @media (prefers-reduced-motion: no-preference) {
    .rise { animation: rise .9s var(--ease) both; animation-delay: calc(var(--i, 0) * 110ms); }
    .track.run .lane-sprint { animation: sprint 1.1s ease-in-out both; }
    .track.run .lane:nth-child(2) .lane-sprint { animation-delay: .12s; }
    .track.run .lane:nth-child(3) .lane-sprint { animation-delay: .24s; }
    .track.run .lane:hover .lane-sprint { animation: none; }
  }
  @keyframes rise { from { opacity: 0; translate: 0 28px; } }
  @keyframes sprint {
    0% { transform: scaleX(0); transform-origin: left; }
    50% { transform: scaleX(1); transform-origin: left; }
    50.01% { transform: scaleX(1); transform-origin: right; }
    100% { transform: scaleX(0); transform-origin: right; }
  }
</style>

<script>
  const track = document.querySelector(".track");
  if (track && "IntersectionObserver" in window) {
    const io = new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) { track.classList.add("run"); io.disconnect(); }
    }, { threshold: .4 });
    io.observe(track);
  }
</script>
