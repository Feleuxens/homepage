---
// Lane 2: music as a printed score.
// Title page, four movements (the services), a concert programme (repertoire),
// a staff of four bars (booking process) and a coda.
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import ProgrammeList from "../components/ProgrammeList.astro";
import PhotoCredit from "../components/PhotoCredit.astro";
import { INSTRUMENTS_LINE } from "../data/career";
import { repertoire } from "../data/repertoire";
import wedding1 from "../../public/images/wedding1.jpg";
import wedding2 from "../../public/images/wedding2.jpg";

const movements = [
  {
    title: "Wedding Ceremonies",
    marking: "Andante", mood: "con amore",
    text: "The right atmosphere for your day, with live piano or trumpet during the ceremony and reception.",
    features: ["Processional & recessional", "Cocktail hour", "Reception background music", "Custom song requests"],
  },
  {
    title: "Memorial Services",
    marking: "Lento", mood: "sostenuto",
    text: "Comfort and solace through carefully chosen music for memorial and funeral services.",
    features: ["Traditional hymns", "Contemporary favourites", "Personal selections", "Sensitive performance"],
  },
  {
    title: "Musical Arrangements",
    marking: "Moderato", mood: "a piacere",
    text: "Piano arrangements of your favourite songs, tailored to an occasion or a skill level.",
    features: ["Popular songs for piano", "Classical adaptations", "Lead sheets & chord charts"],
  },
  {
    title: "Score Transcription",
    marking: "Allegro", mood: "con precisione",
    text: "Handwritten scores turned into clean, digital sheet music.",
    features: ["Handwritten to digital", "Professional notation", "PDF and MusicXML", "Free revisions after completion"],
  },
];

const included = ["Pre-event consultation", "Custom playlist", "Professional attire", "Flexible timing on the day"];

const bars = [
  { title: "Consultation", text: "Your event, your wishes, your music." },
  { title: "Proposal", text: "A detailed proposal and performance agreement." },
  { title: "Preparation", text: "Final details and your custom repertoire." },
  { title: "Performance", text: "Punctual, prepared, and quietly in the background." },
];
const roman = ["I", "II", "III", "IV"];
---

<MainLayout title="Music for Your Occasion" lane={2}
  description="Live piano and trumpet music for weddings, memorials and private celebrations, plus arrangements and score transcription.">

  <div class="score" id="top">
    <!-- Title page -->
    <section class="cover">
      <div class="cover-meta">
        <p class="tempo">Adagio, <em>dolce</em> <span class="mono">♩ = 66</span></p>
        <p class="lane-tag"><span class="chip">2</span>Lane two</p>
      </div>
      <h1>Music for<br />Your Occasion</h1>
      <p class="subtitle">for piano or trumpet, solo or with playback</p>

      <div class="staff" aria-hidden="true">
        <span class="clef">𝄞</span>
        <span class="timesig"><span>4</span><span>4</span></span>
        <svg viewBox="0 0 600 60" preserveAspectRatio="none" class="notes">
          <g fill="currentColor">
            <!-- Bar 1: half + quarter + quarter -->
            <ellipse cx="40" cy="45" rx="9" ry="6" transform="rotate(-20 40 45)" fill="none" stroke="currentColor" stroke-width="2" /><rect x="48" y="13" width="1.6" height="32" />
            <ellipse cx="130" cy="37.5" rx="7" ry="5" transform="rotate(-20 130 37.5)" /><rect x="136" y="5.5" width="1.6" height="32" />
            <ellipse cx="190" cy="30" rx="7" ry="5" transform="rotate(-20 190 30)" /><rect x="196" y="-2" width="1.6" height="32" />
            <rect x="250" y="0" width="1.4" height="60" />
            <!-- Bar 2: quarter + quarter + half -->
            <ellipse cx="300" cy="22.5" rx="7" ry="5" transform="rotate(-20 300 22.5)" /><rect x="306" y="-9.5" width="1.6" height="32" />
            <ellipse cx="360" cy="30" rx="7" ry="5" transform="rotate(-20 360 30)" /><rect x="366" y="-2" width="1.6" height="32" />
            <ellipse cx="440" cy="15" rx="9" ry="6" transform="rotate(-20 440 15)" fill="none" stroke="currentColor" stroke-width="2" /><rect x="448" y="-17" width="1.6" height="32" />
            <rect x="520" y="0" width="1.4" height="60" /><rect x="526" y="0" width="4" height="60" />
          </g>
        </svg>
      </div>

      <p class="dedication">
        <em>for the moments that matter:</em> weddings, memorials and private celebrations.
      </p>
      <div class="cover-cta">
        <a href="/contact" class="btn btn-ink">Book a performance</a>
        <a href="#programme" class="cue">see the programme ↓</a>
      </div>
      <p class="composer">{INSTRUMENTS_LINE}</p>
    </section>

    <!-- Movements: services -->
    <section class="movements" aria-label="Services">
      {movements.map((m, i) => (
        <article class="mv reveal">
          <span class="mv-num" aria-hidden="true">{roman[i]}.</span>
          <div>
            <h2>{m.title}</h2>
            <p class="marking">{m.marking}, <em>{m.mood}</em></p>
            <p class="mv-text">{m.text}</p>
            <ul class="mv-feat list-reset list-notes">{m.features.map(f => <li>{f}</li>)}</ul>
          </div>
        </article>
      ))}
    </section>

    <!-- Plates -->
    <section class="plates reveal" aria-label="Impressions">
      <figure class="plate wide">
        <Image src={wedding1} alt="Hands on the piano during a wedding reception" widths={[640, 1000, 1400]} sizes="(min-width: 900px) 62vw, 100vw" />
        <figcaption><em>Plate I.</em> A wedding with soundtrack and modern music, played to self-arranged playback. <PhotoCredit by="oliver" /></figcaption>
      </figure>
      <figure class="plate tall">
        <Image src={wedding2} alt="Playing at a wedding" widths={[400, 700]} sizes="(min-width: 900px) 30vw, 100vw" />
        <figcaption><em>Plate II.</em> At the piano. <PhotoCredit by="oliver" /></figcaption>
      </figure>
    </section>

    <!-- Programme: repertoire -->
    <section id="programme" class="programme-wrap">
      <article class="programme reveal">
        <p class="pg-kicker">Felix Grüb · Piano &amp; Trumpet</p>
        <h2>Programme</h2>
        <p class="pg-sub">a selection from the repertoire</p>
        {repertoire.map((r, i) => (
          <section class="pg-part">
            <h3><span>Part {roman[i]}</span>{r.part}</h3>
            <ProgrammeList items={r.pieces} stackOnPhones />
          </section>
        ))}
        <p class="pg-note"><em>Can't find your piece?</em> I'm happy to learn new music for your event.</p>
        <a href="/contact" class="btn btn-ink">Request a piece</a>
      </article>
    </section>

    <!-- Booking -->
    <section class="booking">
      <div class="booking-head reveal">
        <p class="marking">Da capo, <em>step by step</em></p>
        <h2>How a booking works</h2>
      </div>
      <div class="system reveal" role="list">
        {bars.map((b, i) => (
          <div class="measure" role="listitem">
            <span class="m-no">{i + 1}</span>
            <strong>{b.title}</strong>
            <span>{b.text}</span>
          </div>
        ))}
      </div>
      <div class="included reveal">
        <p class="inc-head">Included in every booking</p>
        <ul class="list-reset">{included.map(x => <li>{x}</li>)}</ul>
      </div>
    </section>

    <!-- Coda -->
    <section class="coda reveal">
      <p class="marking">Coda, <em>crescendo</em></p>
      <h2>Let's find the music<br />for your day.</h2>
      <div class="cover-cta center">
        <a href="/contact" class="btn btn-ink">Book your event</a>
        <a href="/about" class="cue">my musical background →</a>
      </div>
      <div class="final-bar" aria-hidden="true"></div>
      <p class="fine"><a href="#top">D.C. al Fine</a> · <em>Fine</em></p>
    </section>
  </div>
</MainLayout>

<style>
  .score {
    --mono-tracking: normal; --mono-case: none;
    --staff: color-mix(in oklab, var(--score-ink) 30%, transparent);
    max-width: 66rem; margin: 0 auto; padding: 0 var(--pad);
    background-image: radial-gradient(rgba(0,0,0,.03) 1px, transparent 1px); background-size: 3px 3px;
  }
  h1, h2, h3 { font-family: var(--serif); font-weight: 600; margin: 0; letter-spacing: -.01em; }
  em { font-family: var(--serif); font-style: italic; }
  .btn { --btn-bg: var(--score-ink); --btn-hover-bg: var(--score-red); }
  .cue { font: italic 500 1.1rem/1 var(--serif); color: var(--score-red); text-decoration: none; border-bottom: 1px solid currentColor; }

  /* Title page */
  .cover { text-align: center; padding: clamp(2rem, 5vw, 3.5rem) 0 clamp(4rem, 8vw, 6rem); border-bottom: 1px solid var(--staff); }
  .cover-meta { display: flex; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .tempo, .lane-tag { margin: 0; font: italic 600 1.05rem/1 var(--serif); display: inline-flex; align-items: center; gap: var(--space-2); }
  .tempo em { font-weight: 400; color: var(--score-dim); }
  .lane-tag { font-weight: 400; }
  .chip { --chip-size: 1.6rem; --chip-bg: var(--score-red); --chip-fg: var(--on-accent); border-radius: .25rem; font-size: var(--text-sm); }
  .cover h1 { font-size: clamp(3.2rem, 9.5vw, 8rem); line-height: .95; font-weight: 500; }
  .subtitle { font: italic 400 clamp(1.15rem, 2.4vw, 1.6rem)/1.35 var(--serif); color: var(--score-dim); margin: var(--space-5) 0 2.75rem; }
  /* A plain colour token here: Firefox drops repeating gradients with color-mix() stops */
  .staff, .final-bar { background: repeating-linear-gradient(to bottom, var(--score-staff) 0 1px, transparent 1px 15px) 0 0 / 100% 61px no-repeat; }
  .staff { position: relative; height: 61px; color: var(--score-ink); }
  .clef { position: absolute; left: .25rem; top: -22px; font-size: 92px; line-height: 1; }
  .timesig { position: absolute; left: 74px; top: -5px; height: 50px; display: flex; flex-direction: column; justify-content: space-between; font: 800 34px/30px var(--serif); }
  .timesig span { display: block; height: 25px; }
  .notes { position: absolute; inset: 0 0 0 120px; width: calc(100% - 120px); height: 60px; overflow: visible; }
  .dedication { max-width: 34rem; margin: 2.75rem auto var(--space-8); font-size: 1.15rem; }
  .cover-cta { display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: var(--space-6); }
  .composer { margin: var(--space-12) 0 0; text-align: right; font: italic 400 1rem/1 var(--serif); color: var(--score-dim); }

  /* Movements */
  .movements { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--staff); }
  .mv { display: grid; grid-template-columns: 4.5rem 1fr; gap: var(--space-4); padding: clamp(2.5rem, 5vw, 3.5rem) clamp(1rem, 3vw, 2.5rem) clamp(2.5rem, 5vw, 3.5rem) 0; }
  .mv:nth-child(even) { padding-left: clamp(1rem, 3vw, 2.5rem); border-left: 1px solid var(--staff); }
  .mv:nth-child(n+3) { border-top: 1px solid var(--staff); }
  .mv-num { font: 700 3.2rem/.9 var(--serif); color: var(--score-red); }
  .mv h2 { font-size: clamp(1.6rem, 2.8vw, 2.2rem); line-height: 1.05; }
  .marking { margin: .4rem 0 0; font: italic 600 1.05rem/1.2 var(--serif); }
  .marking em { font-weight: 400; color: var(--score-dim); }
  .mv-text { margin: var(--space-4) 0 .9rem; color: var(--page-fg-2); }
  .mv-feat { font: italic 400 .98rem/1.6 var(--serif); color: var(--score-dim); }
  @media (max-width: 800px) {
    .movements { grid-template-columns: 1fr; }
    .mv, .mv:nth-child(even) { padding-left: 0; border-left: 0; }
    .mv:nth-child(n+2) { border-top: 1px solid var(--staff); }
  }

  /* Plates */
  .plates { display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-6); padding: clamp(3.5rem, 7vw, 5rem) 0; border-bottom: 1px solid var(--staff); align-items: end; }
  .plate { margin: 0; }
  .plate img { width: 100%; object-fit: cover; filter: sepia(.15); }
  .plate.wide img { aspect-ratio: 3/2; }
  .plate.tall img { aspect-ratio: 2/3; max-height: 32rem; }
  .plate figcaption { margin-top: .6rem; font-size: var(--text-sm); color: var(--score-dim); }
  @media (max-width: 700px) { .plates { grid-template-columns: 1fr; } .plate.tall { display: none; } }

  /* Programme */
  .programme-wrap { padding: clamp(4rem, 8vw, 6rem) 0; border-bottom: 1px solid var(--staff); }
  .programme { max-width: 40rem; margin: 0 auto; padding: clamp(2rem, 5vw, 3.5rem); background: var(--surface); text-align: center;
    border: 1px solid var(--staff); outline: 1px solid var(--staff); outline-offset: -10px;
    box-shadow: var(--score-shadow); }
  .pg-kicker { margin: 0 0 var(--space-4); font: 500 .72rem/1 var(--sans); letter-spacing: .2em; text-transform: uppercase; color: var(--score-dim); }
  .programme h2 { font-size: clamp(2.4rem, 5vw, 3.4rem); font-weight: 500; letter-spacing: .02em; }
  .pg-sub { margin: .4rem 0 var(--space-8); font: italic 400 1.05rem/1 var(--serif); color: var(--score-dim); }
  .pg-part { margin-bottom: var(--space-7); text-align: left; }
  .pg-part h3 { display: flex; align-items: baseline; gap: var(--space-3); justify-content: center; margin-bottom: var(--space-3); padding-bottom: var(--space-2); border-bottom: 1px solid var(--staff); font-size: var(--text-lg); }
  .pg-part h3 span { font: italic 400 var(--text-md)/1 var(--serif); color: var(--score-red); }
  .pg-note { margin: var(--space-8) 0 var(--space-5); color: var(--score-dim); }

  /* Booking */
  .booking { padding: clamp(4rem, 8vw, 6rem) 0; border-bottom: 1px solid var(--staff); }
  .booking-head { margin-bottom: var(--space-8); }
  .booking-head h2 { font-size: clamp(2.2rem, 4.5vw, 3.4rem); margin-top: var(--space-2); }
  .system { display: grid; grid-template-columns: repeat(4, 1fr); border-left: 1.5px solid var(--score-ink); border-right: 4px double var(--score-ink);
    background: repeating-linear-gradient(to bottom, transparent 0 calc(20% - 1px), var(--score-staff-soft) calc(20% - 1px) 20%); }
  .measure { position: relative; padding: 1.9rem var(--space-5) var(--space-6); border-right: 1.5px solid var(--score-ink); background: color-mix(in oklab, var(--page-bg) 80%, transparent); }
  .measure:last-child { border-right: 0; }
  .m-no { position: absolute; top: .4rem; left: .5rem; font: italic 500 var(--text-sm)/1 var(--serif); color: var(--score-red); }
  .measure strong { display: block; font: 600 1.3rem/1.2 var(--serif); margin-bottom: .35rem; }
  .measure span:not(.m-no) { font-size: .92rem; color: var(--score-dim); }
  @media (max-width: 760px) { .system { grid-template-columns: 1fr 1fr; } .measure:nth-child(2) { border-right: 0; } .measure:nth-child(-n+2) { border-bottom: 1.5px solid var(--score-ink); } }
  /* "Consultation" no longer fits two columns on the narrowest phones */
  @media (max-width: 23rem) {
    .system { grid-template-columns: 1fr; }
    .measure, .measure:nth-child(2) { border-right: 0; }
    .measure:not(:last-child) { border-bottom: 1.5px solid var(--score-ink); }
  }
  .included { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-6); margin-top: var(--space-8); }
  .inc-head { margin: 0; font: italic 600 1.05rem/1 var(--serif); }
  .included ul { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); color: var(--page-fg-2); }
  .included li::before { content: "— "; color: var(--score-red); }

  /* Coda */
  .coda { text-align: center; padding: clamp(5rem, 10vw, 7rem) 0 3rem; }
  .coda h2 { font-size: clamp(2.4rem, 6vw, 4.6rem); line-height: 1.02; margin: var(--space-4) 0 2.25rem; }
  .final-bar { height: 61px; position: relative; margin-top: var(--space-16); }
  .final-bar::after { content: ""; position: absolute; right: 0; top: 0; bottom: 0; width: 12px; border-left: 1.5px solid var(--score-ink); border-right: 6px solid var(--score-ink); }
  .fine { text-align: right; margin: var(--space-4) 0 0; font: italic 600 1.1rem/1 var(--serif); }
  .fine a { color: var(--score-red); text-decoration: none; }

  @media (prefers-reduced-motion: no-preference) {
    .notes g > * { animation: ink .7s var(--ease) both; }
  }
  @keyframes ink { from { opacity: 0; translate: 0 -6px; } }
</style>
