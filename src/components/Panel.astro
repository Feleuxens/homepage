---
// A dashboard panel. Parents pass their own class for layout; padding goes through
// --panel-pad so that it can't tie in specificity with this file's rule.
import type { HTMLTag } from "astro/types";

interface Props {
  as?: HTMLTag;
  title?: string;
  /** No inner padding, for content that runs edge to edge. */
  flush?: boolean;
  class?: string;
  [attribute: string]: unknown;
}
const { as: Tag = "article", title, flush = false, class: className, ...rest } = Astro.props;
---
<Tag class:list={["panel", { flush }, className]} {...rest}>
  {title && (
    <header class="head">
      <span>{title}</span>
      <slot name="status" />
    </header>
  )}
  <slot />
</Tag>

<style>
  .panel { min-width: 0; padding: var(--panel-pad, 0 1.1rem 1.1rem); background: var(--surface); border: 1px solid var(--surface-line); border-radius: 6px; box-shadow: var(--shadow-panel); }
  .flush { padding: var(--panel-pad, 0); }
  .head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); margin: 0 -1.1rem var(--space-4); padding: .65rem 1.1rem; border-bottom: 1px solid var(--surface-line); background: var(--surface-2); border-radius: 6px 6px 0 0; font-size: var(--text-sm); font-weight: 500; }
  .flush .head { margin: 0; }
</style>
