# Contact form (src/lib/contact). Copy to .env for local development; in production pass these
# to the -dynamic container as environment variables or secrets. Without them the form answers "unavailable".

CONTACT_SMTP_HOST=mail.example.org
# 465 with implicit TLS (CONTACT_SMTP_SECURE=true) or 587 with mandatory STARTTLS (false)
CONTACT_SMTP_PORT=465
CONTACT_SMTP_SECURE=true
CONTACT_SMTP_USER=contact@feleuxens.de
CONTACT_SMTP_PASSWORD=

CONTACT_MAIL_FROM="Kontaktformular <kontakt@feleuxens.de>"
CONTACT_MAIL_TO=me@feleuxens.de

# openssl rand -hex 32
CONTACT_ALTCHA_SECRET=

# Comma-separated; add http://localhost:4321 for local development
CONTACT_ALLOWED_ORIGINS=https://feleuxens.de
CONTACT_DAILY_LIMIT=50
