---
import { Image } from "astro:assets";
import { LANES } from "../lib/site";
import symbol from "../assets/flame-bird-symbol.png";

interface Props {
  /** The lane of the current page; 0 for pages outside the lanes. */
  lane: 0 | 1 | 2 | 3;
}
const { lane } = Astro.props;
---
<header class="site-header">
  <a href="/" class="mark" aria-label="Felix Grüb, home"><Image src={symbol} alt="" widths={[32, 64, 96]} sizes="2rem" loading="eager" />FG</a>
  <button type="button" class="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav">
    <span></span><span></span><span></span>
  </button>
  <nav id="site-nav" aria-label="Main">
    <ul class="list-reset">
      <li><a href="/">Home</a></li>
      {LANES.map(l => (
        <li>
          <a href={l.href} aria-current={lane === l.n ? "page" : undefined}>
            <span class="chip" aria-hidden="true">{l.n}</span>{l.title}
          </a>
        </li>
      ))}
      <li><a href="/about">About</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");

  if (header && toggle) {
    const setOpen = (open: boolean) => {
      header.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => setOpen(!header.classList.contains("open")));
    document.addEventListener("click", event => {
      if (!header.contains(event.target as Node)) setOpen(false);
    });
    document.addEventListener("keydown", event => {
      if (event.key === "Escape" && header.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });
    // Rotating a phone can bring back the full navbar
    window.matchMedia("(max-width: 760px)").addEventListener("change", () => setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    /* Equal outer columns keep the nav centred on the page, not just in the space beside the mark */
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-4);
    padding: .85rem var(--pad);
    background: color-mix(in oklab, var(--page-bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--page-line);
  }
  .mark { display: inline-flex; align-items: center; gap: .4rem; justify-self: start; font: 700 1.35rem/1 var(--serif); text-decoration: none; letter-spacing: -.03em; }
  .mark img { width: 2rem; height: 2rem; }
  ul { display: flex; gap: var(--space-7); }
  nav a { display: inline-flex; align-items: center; text-decoration: none; font-size: .9rem; font-weight: 500; transition: color .15s; }
  nav a:hover { color: var(--track-text); }
  nav a[aria-current="page"] { box-shadow: 0 2px 0 var(--track); }
  nav a[aria-current="page"] .chip { --chip-bg: var(--track); --chip-fg: var(--on-accent); }
  .chip { margin-right: .5em; font-size: .72rem; }
  .menu-toggle { display: none; }

  /* Without JavaScript the links simply wrap onto their own row */
  @media (max-width: 760px) {
    .site-header { grid-template-columns: 1fr auto; }
    nav { grid-column: 1 / -1; }
    ul { flex-wrap: wrap; gap: var(--space-2) var(--space-4); }
  }

  /* With JavaScript they move into a dropdown that overlays the page */
  @media (max-width: 760px) and (scripting: enabled) {
    .menu-toggle {
      display: flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 2.75rem; height: 2.75rem; margin: -.65rem -.6rem -.65rem 0; padding: .6rem;
      border: 0; background: none; color: inherit; cursor: pointer;
    }
    .menu-toggle span { display: block; height: 2px; background: currentColor; transition: transform .15s, opacity .15s; }
    .open .menu-toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .open .menu-toggle span:nth-child(2) { opacity: 0; }
    .open .menu-toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* visibility also takes the closed links out of the tab order and away from screen readers */
    nav {
      /* grid-column: auto, or the panel would be limited to the grid area inside the header's padding */
      position: absolute; inset: 100% 0 auto; grid-column: auto;
      display: grid; grid-template-rows: 0fr; visibility: hidden;
      background: var(--page-bg);
      transition: grid-template-rows .15s, visibility .15s;
    }
    .open nav { grid-template-rows: 1fr; visibility: visible; border-bottom: 1px solid var(--page-line); box-shadow: var(--shadow-sheet); }
    ul { display: block; min-height: 0; overflow: hidden; padding-inline: var(--pad); }
    li:first-child { padding-top: var(--space-2); }
    li:last-child { padding-bottom: var(--space-2); }
    nav a { display: flex; padding-block: .7rem; font-size: var(--text-base); }
    nav a[aria-current="page"] { box-shadow: none; }
    .chip { font-size: .8rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-toggle span, nav { transition: none; }
  }
</style>
