---
// A piece of featured work that links to its topic page as a whole card.
// The title takes the topic colour.
import { Image } from "astro:assets";
import type { Theme } from "../lib/theme";

interface Props {
    href: string;
    theme: Theme;
    image: ImageMetadata;
    alt: string;
    title: string;
    description: string;
}

const { href, theme, image, alt, title, description } = Astro.props;
---
<a href={href} class={`card card-link appear group theme-${theme}`}>
    <div class="aspect-video bg-gray-200 overflow-hidden">
        <Image
            src={image}
            alt={alt}
            width="750"
            height="500"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
    </div>
    <div class="p-6">
        <h3 class="text-xl mb-2 text-(--theme-color)">{title}</h3>
        <p>{description}</p>
    </div>
</a>
