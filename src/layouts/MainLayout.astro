---
// Shared shell for every page.
// The header and footer are identical on every page; each page brings its own world
// (dashboard, score, viewfinder) and only tells the shell which lane it is.
import "@fontsource-variable/roboto";
import "@fontsource-variable/playfair-display";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  /** 0 = home/about, 1 = IT, 2 = music, 3 = photography */
  lane?: 0 | 1 | 2 | 3;
}

const {
  title,
  description = "IT services and consulting, live music on piano and trumpet, and photography by Felix Grüb.",
  lane = 0,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
  <link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{`${title} | Felix Grüb`}</title>
  <script defer data-domain="feleuxens.de" data-api="/plausible/api/event" src="/plausible/js/script.file-downloads.outbound-links.tagged-events.js"></script>
  <script>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <SiteHeader lane={lane} />

  <main id="main">
    <slot />
  </main>

  <SiteFooter />

  <script>
    // Reveal on scroll. Content stays visible without JS or with reduced motion.
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce && "IntersectionObserver" in window) {
      document.documentElement.classList.add("js-reveal");
      const io = new IntersectionObserver(entries => {
        for (const e of entries) {
          if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
        }
      }, { rootMargin: "0px 0px -8% 0px" });
      document.querySelectorAll(".reveal").forEach(el => io.observe(el));
    }
  </script>
</body>
</html>

<style>
  .skip { position: absolute; left: -999px; }
  .skip:focus { left: 1rem; top: 1rem; z-index: 100; background: var(--page-fg); color: var(--page-bg); padding: var(--space-2) var(--space-4); }
</style>
