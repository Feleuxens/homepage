---
import MainLayout from '../layouts/MainLayout.astro';
import "../styles/about.css"
import { Image } from "astro:assets";
import meImg from "../../public/images/me.jpg";
import backgroundImg from "../../public/images/hero-bg.jpg";
import weddingImg from "../../public/images/wedding1.jpg";
import photographerImg from "../../public/images/photographer2.jpg";
import sharp from "sharp";
import path from "node:path";

// Tiny blurred stand-in, inlined so the hero is never empty while the real image loads
const heroPlaceholderBuffer = await sharp(path.join(process.cwd(), "public/images/hero-bg.jpg"))
    .resize(32)
    .webp({ quality: 50 })
    .toBuffer();
const heroPlaceholder = `data:image/webp;base64,${heroPlaceholderBuffer.toString("base64")}`;

const currentYear = new Date().getFullYear();

// Taken from /tech-services, so the homepage promises exactly what that page offers
const itServices = [
  {
    title: "DevOps Implementation",
    description: "CI/CD pipelines, automation and infrastructure as code.",
  },
  {
    title: "System Administration",
    description: "System management, monitoring and optimization for peak performance.",
  },
  {
    title: "Containerization",
    description: "Docker and Kubernetes for scalable, portable deployments.",
  },
  {
    title: "Cloud Architecture",
    description: "Scalable, secure cloud infrastructure tailored to your needs.",
  },
];
---
<MainLayout title="Home" description="Felix Grüb: IT services and consulting, live music on piano and trumpet, and sports photography.">
  <!-- Hero Section -->
  <section class="relative overflow-hidden h-svh">
    <div class="absolute inset-0 bg-black/40 z-10"></div>
    <div class="absolute inset-0 bg-cover bg-center scale-110 blur-xl" style={`background-image: url(${heroPlaceholder});`}></div>
    <Image
        src={backgroundImg}
        alt=""
        width={2400}
        height={1600}
        widths={[640, 1024, 1600, 2400]}
        sizes="100vw"
        quality={80}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 w-full h-full object-cover"
    />

    <!-- Hero Content -->
    <div class="container relative z-20 h-full flex items-center justify-center pt-20">
      <div class="text-center">
        <h1 class="text-display mb-6 text-white enter">Felix Grüb</h1>
        <p class="font-serif text-xl md:text-2xl mb-8 max-w-2xl mx-auto text-white enter" style="--enter-index: 1">
          IT Services & Consulting, Live Music and Photography
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center enter" style="--enter-index: 2">
          <a href="/tech-services" class="btn theme theme-primary">IT Services</a>
          <a href="/music" class="btn theme theme-secondary">Live Music</a>
          <a href="/photography" class="btn theme theme-accent">Photography</a>
        </div>
      </div>
    </div>
  </section>

  <!-- IT: the main topic, on the page's home colour -->
  <section class="py-24 md:py-32 bg-white theme-primary">
    <div class="container grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5 appear">
        <h2 class="text-headline font-serif font-bold mb-6">IT Services & Consulting</h2>
        <p class="text-lg mb-8 max-w-prose">
          Professional infrastructure setup, CI/CD pipelines, system administration, and system automation tailored to your business needs.
        </p>
        <a href="/tech-services" class="btn theme">Explore IT Services</a>
      </div>

      <ul class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-12 content-start">
        {itServices.map(service => (
          <li class="appear">
            <h3 class="text-2xl mb-3 text-(--theme-color)">{service.title}</h3>
            <p class="text-lg">{service.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Music: one large picture, text beside it -->
  <section class="py-24 md:py-32 bg-secondary/5 theme-secondary">
    <div class="container grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
      <a href="/music" class="md:col-span-7 card card-link group appear">
        <div class="aspect-[3/2] overflow-hidden">
          <Image
              src={weddingImg}
              alt="Playing the piano at a wedding"
              widths={[640, 960, 1280]}
              sizes="(min-width: 768px) 58vw, 100vw"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>
      </a>

      <div class="md:col-span-5 appear">
        <h2 class="text-headline font-serif font-bold mb-6">Music for Your Occasion</h2>
        <p class="text-lg mb-6 max-w-prose">
          Piano or trumpet, solo or with playback, for the moments that matter: weddings, funerals and private celebrations.
        </p>
        <p class="text-lg mb-8 max-w-prose">
          Featured: a wedding with soundtrack and modern music, played to self-arranged playback.
        </p>
        <a href="/music" class="btn theme">Explore Live Music</a>
      </div>
    </div>
  </section>

  <!-- Photography: mirrors the music section, picture on the right -->
  <section class="py-24 md:py-32 bg-white theme-accent">
    <div class="container grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
      <!-- First in the markup so phones show the picture first, as in the music section -->
      <a href="/photography" class="md:col-span-7 md:order-last card card-link group appear">
        <div class="aspect-[3/2] overflow-hidden">
          <Image
              src={photographerImg}
              alt="Photographing at the Track and Field National Championships"
              widths={[640, 960, 1280]}
              sizes="(min-width: 768px) 58vw, 100vw"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>
      </a>

      <div class="md:col-span-5 appear">
        <h2 class="text-headline font-serif font-bold mb-6">Photography</h2>
        <p class="text-lg mb-6 max-w-prose">
          Mostly a passion, also available for commercial work. As an athlete myself, I'm drawn above all to the intensity of competitive sports.
        </p>
        <p class="text-lg mb-8 max-w-prose">
          Featured: photographing at the Track and Field National Championships Indoor.
        </p>
        <a href="/photography" class="btn theme">View the Portfolio</a>
      </div>
    </div>
  </section>

  <!-- About Preview Section -->
  <section class="py-24 md:py-32 bg-gray-100">
    <div class="container">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="about-image appear">
          <Image src={meImg} alt="Portrait of Felix Grüb" class="profile-photo" width="500" height="500" position='top' />
        </div>

        <div class="about-content appear">
          <h2 class="section-title text-headline">About Me</h2>
          <p class="text-lg mb-6 max-w-prose">
            I love variety and have a whole range of different interests. This allows me to combine different perspectives and solve problems with a unique approach.
          </p>
          <p class="text-lg mb-8 max-w-prose">
            With over { currentYear-2022 } years in the IT industry and a lifelong passion for music, I bring both analytical precision and creative expression to everything I do.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="/about" class="btn theme">Learn More About Me</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Preview -->
  <section class="py-24 md:py-32 bg-primary text-white">
    <div class="container text-center appear">
      <h2 class="section-title text-headline text-white">Let's Work Together</h2>
      <p class="text-lg max-w-2xl mx-auto mb-10 text-white">
        Whether you need technical expertise for your infrastructure or live music for your event, I'm here to help.
      </p>
      <a href="/contact" class="btn white">Contact Me</a>
    </div>
  </section>
</MainLayout>
