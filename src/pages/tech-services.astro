---
// Lane 1: IT services as a monitoring dashboard.
// Panels and a CI pipeline for the process. No made-up metrics: every number
// shown is either a real date or purely decorative (sparklines without axes or values).
import MainLayout from "../layouts/MainLayout.astro";
import Panel from "../components/Panel.astro";
import Status from "../components/Status.astro";
import StatusDot from "../components/StatusDot.astro";
import JobIcon from "../components/JobIcon.astro";
import ServerStatus from "../components/ServerStatus.astro";
import { CAREER } from "../data/career";
import { pipeline } from "../data/pipeline";
import { services } from "../data/services";
import { EMAIL } from "../lib/site";

const stack = [
  { area: "Containers", tools: ["Docker", "Kubernetes", "Helm"] },
  { area: "CI/CD", tools: ["GitLab CI", "GitHub Actions"] },
  { area: "Infrastructure as code", tools: ["Terraform"] },
  { area: "Observability", tools: ["Grafana", "Prometheus", "TheTRÄP", "Greenbone"] },
  { area: "Networking & identity", tools: ["WireGuard", "Tailscale", "nginx", "Keycloak"] },
  { area: "Operating systems", tools: ["Linux", "macOS", "Windows"] },
  { area: "Languages", tools: ["Python", "Rust", "Java", "Swift"] },
];

// Deterministic, decorative sparkline (no axis, no values)
function spark(seed: number): string {
  let v = 20;
  const pts: string[] = [];
  for (let i = 0; i <= 40; i++) {
    const n = Math.sin(i * 0.9 + seed * 2.1) * 3 + Math.sin(i * 0.31 + seed) * 4;
    v = 20 + n;
    pts.push(`${i * 5},${v.toFixed(1)}`);
  }
  return pts.join(" ");
}

// Two panels for now. With more entries, a table with expandable summaries would scale better.
const academicWork = [
  {
    title: "Efficient Homomorphic Comparison Methods",
    kind: "Seminar paper",
    when: "Summer 2025",
    summary: "A survey of how values can be compared on encrypted data, and the trade-offs between accuracy, efficiency and complexity.",
    pdf: "https://github.com/Feleuxens/Hauptseminar/blob/HEAD/Efficient-Homomorphic-Comparison-Methods.pdf",
    tags: ["Homomorphic encryption", "Cryptography"],
  },
  {
    title: "Understanding Deployment Models: A Study on EDMM versus Kubernetes",
    kind: "Bachelor's thesis",
    when: "2024",
    summary: "Extended the DeMAF Kubernetes plugin and ran a user study comparing how understandable EDMM and Kubernetes deployment models are.",
    pdf: "https://github.com/Feleuxens/Bachelors-Thesis/blob/HEAD/Understanding%20Deployment%20Models%20-%20A%20Study%20on%20EDMM%20versus%20Kubernetes.pdf",
    tags: ["Kubernetes", "EDMM", "User study"],
  },
];

const projects = [
  { name: "Own server", text: "A rented server I run and maintain myself. System administration is a big hobby of mine; it hosts this site and my other services.", tags: ["System administration"], live: true, link: { href: "https://status.feleuxens.de", label: "Status page ↗" } },
  { name: "OnYourMarks", text: "A small iOS app that gives start commands for running.", tags: ["iOS", "Swift"], link: { href: "https://github.com/Feleuxens/OnYourMarks", label: "View on GitHub ↗" } },
  { name: "Photo analysis", text: "Generates photo descriptions in my gallery, based on bib numbers.", tags: ["Image analysis"] },
];

const since = CAREER.studyFrom;
const working = CAREER.workFrom;
---

<MainLayout title="IT Services" lane={1}
  description="IT services and consulting by Felix Grüb: DevOps, system administration, containerization and software architecture.">

  <div class="dash">
    <!-- Dashboard toolbar -->
    <div class="toolbar">
      <p class="crumbs mono"><span class="chip chip-track">1</span> Lanes <span>/</span> Dashboards <span>/</span> <b>IT Services</b></p>
      <div class="tools mono" aria-hidden="true">
        <span class="pick live"><StatusDot pulse /> Live</span>
      </div>
    </div>

    <!-- Row: overview -->
    <section class="row r-overview">
      <Panel title="Overview" class="hero-panel reveal">
        <span slot="status" class="menu" aria-hidden="true">⋮</span>
        <div class="hero-body">
          <h1>Infrastructure that stays boring.</h1>
          <p>
            I've worked in DevOps since {CAREER.workFrom} and run my own server. That means regular updates, deploying
            services in Docker containers and working out why something broke. Nothing too exciting, which is the point.
          </p>
          <div class="actions">
            <a href="/contact" class="btn btn-accent">Start a project</a>
            <a href="#services" class="btn btn-ghost">See services ↓</a>
          </div>
        </div>
      </Panel>

      <Panel title="In operation since" class="stat reveal">
        <p class="big mono">{since}</p>
        <p class="sub">Studying computer science since {since}, working student in DevOps &amp; system administration since {working}.</p>
      </Panel>

      <Panel title="Background" class="stat reveal">
        <Status slot="status" tone="info">in progress</Status>
        <p class="big mono sm">M.Sc. Computer Science</p>
        <p class="sub">University of Stuttgart, interested in cryptography and system and web security. B.Sc. {CAREER.bachelorUntil}.</p>
      </Panel>
    </section>

    <!-- Row: academic work -->
    <h2 class="row-title"><span aria-hidden="true">▾</span> Academic work</h2>
    <section class="row r-papers">
      {academicWork.map(w => (
        <Panel title={w.kind} class="paper reveal">
          <span slot="status" class="mono paper-when">{w.when}</span>
          <h3>{w.title}</h3>
          <p>{w.summary}</p>
          <p class="paper-tags">{w.tags.map(t => <span class="tag">{t}</span>)}</p>
          <a href={w.pdf} target="_blank" rel="noopener" class="btn btn-ghost">Read the PDF ↗</a>
        </Panel>
      ))}
    </section>

    <!-- Row: services -->
    <h2 class="row-title" id="services"><span aria-hidden="true">▾</span> Services <span class="count mono">{services.length} panels</span></h2>
    <section class="row r-services">
      {services.map((s, i) => (
        <Panel title={s.title} class="svc reveal">
          <Status slot="status" pulse>available</Status>
          <svg class="spark" viewBox="0 0 200 40" preserveAspectRatio="none" aria-hidden="true">
            <polyline points={spark(i + 1)} />
            <polygon points={`0,40 ${spark(i + 1)} 200,40`} />
          </svg>
          <p>{s.description}</p>
          <ul class="feat list-reset">
            {s.features.map(f => <li><span class="tick" aria-hidden="true">✓</span>{f}</li>)}
          </ul>
        </Panel>
      ))}
    </section>

    <!-- Row: process as a pipeline -->
    <h2 class="row-title"><span aria-hidden="true">▾</span> How a project would run <span class="count mono">pipeline · not started</span></h2>
    <Panel as="section" class="pipeline reveal" aria-label="Project process">
      <ol class="stages list-reset">
        {pipeline.map((p, i) => (
          <li class="stage">
            <p class="stage-name mono">{String(i + 1).padStart(2, "0")} · {p.stage}</p>
            <div class="job">
              <JobIcon />
              <span class="job-name">{p.title}</span>
            </div>
            <p class="stage-text">{p.text}</p>
          </li>
        ))}
      </ol>
    </Panel>

    <!-- Row: stack -->
    <h2 class="row-title"><span aria-hidden="true">▾</span> Stack <span class="count mono">tools in daily use</span></h2>
    <Panel as="section" flush class="stack reveal">
      <table>
        <thead><tr><th scope="col">Area</th><th scope="col">Tools</th></tr></thead>
        <tbody>
          {stack.map(r => (
            <tr><th scope="row">{r.area}</th><td>{r.tools.map(t => <span class="tag">{t}</span>)}</td></tr>
          ))}
        </tbody>
      </table>
    </Panel>

    <!-- Row: private projects -->
    <h2 class="row-title"><span aria-hidden="true">▾</span> Private projects <span class="count mono">{projects.length} panels</span></h2>
    <section class="row r-projects">
      {projects.map(p => (
        <Panel title={p.name} class="project reveal">
          <Status slot="status" pulse>running</Status>
          <p>{p.text}</p>
          {p.live && (
            <div class="project-live">
              <ServerStatus server:defer><ServerStatus slot="fallback" pending /></ServerStatus>
            </div>
          )}
          <p class="paper-tags">{p.tags.map(t => <span class="tag">{t}</span>)}</p>
          {p.link && <a href={p.link.href} target="_blank" rel="noopener" class="project-link">{p.link.label}</a>}
        </Panel>
      ))}
    </section>

    <!-- Where this is heading -->
    <Panel as="aside" title="Next" class="next-note reveal">
      <Status slot="status" tone="info">direction</Status>
      <p>IT security is where I want to take my work. My Master's modules are heading there, with cryptography and system and web security, but I'm still early in the field, so it's a direction and not a service I offer yet.</p>
    </Panel>

    <!-- Call to action, as a row in an alert list -->
    <Panel as="section" title="Alerts" class="alert reveal">
      <Status slot="status" tone="danger">1 firing</Status>
      <div class="alert-row">
        <div>
          <h2>Something that needs automating?</h2>
          <p>Tell me about your setup and what keeps breaking.</p>
        </div>
        <div class="actions">
          <a href="/contact" class="btn btn-accent">Start a conversation</a>
          <a href={`mailto:${EMAIL}`} class="btn btn-ghost">{EMAIL}</a>
        </div>
      </div>
    </Panel>
  </div>
</MainLayout>

<style>
  .dash {
    --mono-tracking: .03em; --mono-case: none;
    max-width: 92rem; margin: 0 auto; padding: var(--space-5) var(--pad) var(--space-16);
  }
  .btn { --btn-pad: var(--space-3) 1.2rem; --btn-radius: 4px; font-size: var(--text-md); }

  .toolbar { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); flex-wrap: wrap; padding: var(--space-2) 0 var(--space-5); }
  .crumbs { margin: 0; color: var(--page-dim); display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; }
  .crumbs b { color: var(--page-fg); font-weight: 600; }
  .crumbs .chip { --chip-size: 1.4rem; border-radius: .25rem; font-size: var(--text-xs); }
  .tools { display: flex; gap: var(--space-2); }
  .pick { padding: .4rem .7rem; border: 1px solid var(--surface-line); border-radius: 4px; background: var(--surface); color: var(--page-fg-2); }
  .pick.live { color: var(--ok); display: inline-flex; align-items: center; gap: .4rem; }

  .row { display: grid; gap: var(--space-3); margin-bottom: var(--space-3); }
  .row-title { display: flex; align-items: center; gap: .6rem; margin: var(--space-8) 0 var(--space-3); font: 600 1rem/1 var(--sans); }
  .row-title > span:first-child { color: var(--page-dim); font-size: .8rem; }
  .row-title .count { margin-left: auto; color: var(--page-dim); font-weight: 400; }
  .menu { color: var(--page-dim); }

  /* Overview row */
  .r-overview { grid-template-columns: 2.6fr 1fr; grid-template-areas: "hero s1" "hero s2"; }
  .hero-panel { grid-area: hero; }
  .r-overview .stat:nth-of-type(2) { grid-area: s1; }
  .r-overview .stat:nth-of-type(3) { grid-area: s2; }
  .hero-body { padding: clamp(.5rem, 2vw, 1.5rem) clamp(0rem, 1.5vw, 1rem) .5rem; }
  .hero-body h1 { margin: 0 0 var(--space-5); font: 700 clamp(2.4rem, 5.6vw, 5rem)/1 var(--sans); letter-spacing: -.035em; }
  .hero-body h1 em { font-family: var(--serif); }
  .hero-body p { color: var(--page-fg-2); font-size: 1.1rem; max-width: 36rem; margin: 0 0 var(--space-7); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .stat .big { margin: var(--space-1) 0 var(--space-1); font-size: clamp(2.2rem, 4vw, 3.2rem); font-weight: 600; letter-spacing: -.02em; line-height: 1; }
  .stat .big.sm { font-size: clamp(1.6rem, 3vw, 2.3rem); }
  .stat .sub { margin: var(--space-2) 0 0; color: var(--page-dim); font-size: .88rem; }
  @media (max-width: 1100px) {
    .r-overview { grid-template-columns: 1fr 1fr; grid-template-areas: "hero hero" "s1 s2"; }
  }
  @media (max-width: 600px) {
    .r-overview { grid-template-columns: 1fr; grid-template-areas: "hero" "s1" "s2"; }
  }

  /* Academic work */
  .r-papers { grid-template-columns: repeat(2, 1fr); }
  @media (max-width: 860px) { .r-papers { grid-template-columns: 1fr; } }
  .paper h3 { margin: 0 0 var(--space-2); font: 600 1.05rem/1.3 var(--sans); }
  .paper p, .project p { margin: 0; color: var(--page-fg-2); font-size: var(--text-md); }
  .paper .paper-tags { margin: var(--space-3) 0 var(--space-4); }
  .paper-when { color: var(--page-dim); }
  /* Phones: keep the papers short, so Services isn't far down the page */
  @media (max-width: 600px) {
    .paper .paper-tags { display: none; }
    .paper .btn { --btn-pad: .55rem .9rem; margin-top: .9rem; font-size: .88rem; }
  }

  /* Services */
  .r-services { grid-template-columns: repeat(4, 1fr); }
  @media (max-width: 1100px) { .r-services { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .r-services { grid-template-columns: 1fr; } }
  .svc { scroll-margin-top: 6rem; }
  .spark { width: 100%; height: 2.5rem; margin-bottom: var(--space-3); }
  .spark polyline { fill: none; stroke: var(--ok); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .spark polygon { fill: color-mix(in oklab, var(--ok) 14%, transparent); }
  .svc p { margin: 0 0 var(--space-4); color: var(--page-fg-2); font-size: var(--text-md); }
  .feat { padding: var(--space-3) 0 0; border-top: 1px dashed var(--surface-line); font-size: .9rem; }
  .feat li { display: flex; gap: .6rem; padding: .2rem 0; }
  .tick { color: var(--ok); }

  /* Pipeline */
  .pipeline { --panel-pad: var(--space-6) 1.1rem; overflow-x: auto; }
  .stages { display: grid; grid-template-columns: repeat(4, minmax(13rem, 1fr)); gap: var(--space-10); position: relative; }
  .stage { position: relative; }
  .stage:not(:last-child)::after { content: ""; position: absolute; top: 3.15rem; left: calc(100% - .25rem); width: 2.75rem; height: 2px; background: var(--surface-line); }
  .stage-name { margin: 0 0 .8rem; color: var(--page-dim); text-transform: uppercase; }
  .job { display: flex; align-items: center; gap: .6rem; padding: .6rem .85rem; border: 1px solid var(--surface-line); border-radius: 999px; background: var(--surface-2); font-size: .9rem; font-weight: 500; }
  .stage-text { margin: .9rem 0 0; color: var(--page-dim); font-size: .9rem; }

  /* Stack table */
  .stack { overflow-x: auto; }
  .stack table { width: 100%; border-collapse: collapse; font-size: .92rem; }
  .stack th, .stack td { text-align: left; padding: var(--space-3) 1.1rem; border-bottom: 1px solid var(--surface-line); vertical-align: middle; }
  .stack thead th { font-weight: 500; color: var(--page-dim); font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; background: var(--surface-2); }
  .stack tbody th { font-weight: 500; white-space: nowrap; width: 14rem; }
  .stack tr:last-child th, .stack tr:last-child td { border-bottom: 0; }
  .stack tbody tr:hover { background: var(--surface-2); }
  .tag { display: inline-block; margin: .15rem .35rem .15rem 0; padding: .2rem .55rem; border-radius: 3px; background: color-mix(in oklab, var(--info) 10%, var(--surface)); color: var(--info); font: 500 .8rem/1.4 var(--mono); }

  /* Private projects */
  .r-projects { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 860px) { .r-projects { grid-template-columns: 1fr; } }
  .project .paper-tags { margin: var(--space-3) 0 .6rem; }
  .project-link { color: var(--info); font-weight: 500; font-size: .92rem; text-decoration: none; }
  .project-link:hover { text-decoration: underline; }

  .project-live { margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px dashed var(--surface-line); }

  /* Direction note */
  .next-note p { margin: 0; max-width: 58rem; color: var(--page-fg-2); }

  /* Call to action, as a row in an alert list */
  .alert { margin-top: var(--space-10); }
  .alert-row { display: flex; justify-content: space-between; align-items: center; gap: var(--space-5) var(--space-8); flex-wrap: wrap; padding-block: var(--space-2); }
  .alert h2 { margin: 0 0 .4rem; font: 700 clamp(1.5rem, 3vw, 2.2rem)/1.1 var(--sans); letter-spacing: -.02em; }
  .alert p { margin: 0; color: var(--page-fg-2); }
  .alert .alert-labels { margin-top: var(--space-2); color: var(--page-dim); }

  @media (prefers-reduced-motion: no-preference) {
    .spark polyline { stroke-dasharray: 600; stroke-dashoffset: 600; animation: draw 1.6s var(--ease) forwards .2s; }
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
</style>
