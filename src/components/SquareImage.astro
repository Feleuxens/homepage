---
import { Image, getImage } from "astro:assets";
import { exifData } from "../data/exif-data";
import "../styles/lightbox.css";

interface Props {
    /** Imported image (from src/assets or public/, per your setup). */
    src: ImageMetadata;
    alt: string;
    /** Public URL of the original file, e.g. /images/photography/favorites/x.jpg */
    path: string;
    /** Thumbnail height in px. Width is derived from the aspect ratio. */
    size?: number;
    /** Full-size height in px, used for the lightbox. */
    fullSize?: number;
    quality?: number;
    /** Pre-resolved caption. Falls back to a lookup by path. */
    preset_caption?: string;
}


const {
    src,
    alt,
    path,
    size = 750,
    fullSize = 1600,
    quality = 90,
    preset_caption,
} = Astro.props;

const meta = exifData["public" + path] ?? {};

const aspectRatio: number = meta.aspectRatio || 1;
if (!(aspectRatio > 0)) {
    throw new Error(`SquareImage: invalid aspect ratio (${aspectRatio}) for ${path}`);
}
const caption = preset_caption ?? meta.caption ?? "No exif data";

let thumbWidth;
let thumbHeight;
let fullWidth;
let fullHeight;

thumbHeight = size * aspectRatio;
thumbWidth = size;
if (aspectRatio >= 1) {
    fullHeight = fullSize;
    fullWidth = fullSize / aspectRatio;
} else {
    fullHeight = fullSize * aspectRatio;
    fullWidth = fullSize;
}

// Generate the full-size variant at build time without emitting a second <img>.
const full = await getImage({
    src,
    width: fullWidth,
    height: fullHeight,
    quality: 90,
});

if (typeof full.src !== "string" || full.src.length === 0) {
    throw new Error(`SquareImage: getImage returned no src for ${path}`);
}
---
<button
        type="button"
        data-lightbox
        data-full={full.src}
        data-w={fullWidth}
        data-h={fullHeight}
        data-caption={caption ?? "No exif data"}
        data-original={path}
        data-alt={alt}
>
    <Image
        src={src}
        alt={alt}
        width={thumbWidth}
        height={thumbHeight}
        quality={quality}
        decoding="async"
        loading="lazy"
    />
</button>

<script>
    import { initLightbox } from "../lib/lightbox";
    initLightbox();
</script>

<style>
    button { display: block; width: 100%; height: 100%; padding: 0; margin: 0; border: 0; background: none; cursor: zoom-in; }
    img { width: 100%; height: 100%; object-fit: cover; }
</style>
