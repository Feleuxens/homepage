---
// Contact as the finish line. Same form, same field names, same API
// (src/pages/api/contact, src/lib/contact); the topic select becomes a lane picker.
import MainLayout from "../layouts/MainLayout.astro";
import { LIMITS, SERVICES } from "../lib/contact/fields";
import { EMAIL as email, SOCIAL } from "../lib/site";

// Which lane each topic belongs to (keys are the values the API expects)
const laneOf: Record<keyof typeof SERVICES, string> = {
  it: "1",
  performance: "2",
  arrangement: "2",
  photography: "3",
  other: "·",
};
---

<MainLayout title="Contact" lane={0}
  description="Get in touch with Felix Grüb about IT services, live music, arrangements or photography.">

  <div class="ct">
    <div class="checker checker-invert" aria-hidden="true"></div>

    <section class="wrap ct-head">
      <h1>Let's talk.</h1>
      <p class="lede">A pipeline that needs building, a wedding that needs music, or a race that needs photographing: tell me about it.</p>
    </section>

    <section class="wrap ct-grid">
      <!-- Form: handled by src/pages/api/contact, see src/lib/contact -->
      <div class="ct-form">
        <noscript>
          <p class="note">The form needs JavaScript. You can also write to me directly at <a href={`mailto:${email}`}>{email}</a>.</p>
        </noscript>
        <form id="contact-form" data-fallback-email={email}>
          <fieldset class="lanes-pick">
            <legend>Which lane? <span class="req" aria-hidden="true">*</span></legend>
            <div class="pick-grid">
              {Object.entries(SERVICES).map(([value, label], i) => (
                <label class="pick">
                  <input type="radio" name="service" value={value} required={i === 0} />
                  <span class="pick-box">
                    <span class="chip pick-lane" aria-hidden="true">{laneOf[value as keyof typeof SERVICES]}</span>
                    <span class="pick-label">{label}</span>
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="row2">
            <div class="field">
              <label for="firstName">First name <span class="req" aria-hidden="true">*</span></label>
              <input type="text" id="firstName" name="firstName" required maxlength={LIMITS.name} autocomplete="given-name" placeholder="Max" />
            </div>
            <div class="field">
              <label for="lastName">Last name <span class="req" aria-hidden="true">*</span></label>
              <input type="text" id="lastName" name="lastName" required maxlength={LIMITS.name} autocomplete="family-name" placeholder="Mustermann" />
            </div>
          </div>

          <div class="row2">
            <div class="field">
              <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
              <input type="email" id="email" name="email" required maxlength={LIMITS.email} autocomplete="email" placeholder="max@example.de" />
            </div>
            <div class="field">
              <label for="phone">Phone <span class="opt">optional</span></label>
              <input type="tel" id="phone" name="phone" maxlength={LIMITS.phone} autocomplete="tel" placeholder="+49 123 456789" />
            </div>
          </div>

          <div class="field date">
            <label for="eventDate">Event or project date <span class="opt">optional</span></label>
            <input type="date" id="eventDate" name="eventDate" />
          </div>

          <div class="field">
            <label for="message">What's it about? <span class="req" aria-hidden="true">*</span></label>
            <textarea id="message" name="message" rows="6" required minlength={LIMITS.messageMin} maxlength={LIMITS.messageMax}
              placeholder="Your project or event, timeline, and anything specific I should know."></textarea>
          </div>

          <!-- Honeypot: invisible to people and screen readers; bots that fill it are ignored -->
          <div class="hp" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <label class="consent">
            <input type="checkbox" id="privacy" name="privacy" required />
            <span>I agree to the <a href="/privacy" target="_blank">privacy policy</a> and consent to being contacted about my inquiry. <span class="req" aria-hidden="true">*</span></span>
          </label>

          <!-- Self-hosted spam protection: solves a small task in the background, no cookies, no third parties -->
          <altcha-widget challenge="/api/contact/challenge" auto="onfocus" display="invisible" name="altcha"></altcha-widget>

          <button type="submit" id="submit-btn" class="btn btn-ink send">Send Message</button>
          <div id="form-message" class="hidden" role="status" aria-live="polite"></div>
        </form>
      </div>

      <!-- Side: direct contact -->
      <aside class="ct-side">
        <div class="side-block">
          <p class="side-label">Email</p>
          <a href={`mailto:${email}`} class="mail">{email}</a>
          <p class="side-note">Best for detailed inquiries.</p>
        </div>
        <div class="side-block">
          <p class="side-label">Location</p>
          <p class="side-val">Filderstadt</p>
          <p class="side-note">Available for regional travel.</p>
        </div>
        <div class="side-block">
          <p class="side-label">Availability</p>
          <p class="side-val">Replies usually within a day or two</p>
          <p class="side-note">Weekend events welcome.</p>
        </div>
        <div class="side-block">
          <p class="side-label">Elsewhere</p>
          <ul class="social list-reset">
            {SOCIAL.map(s => <li><a href={s.href} target="_blank" rel="noopener">{s.name}</a></li>)}
          </ul>
        </div>
      </aside>
    </section>
  </div>

  <script>
    import { initContactForm } from "../lib/contact/form";
    initContactForm(document.getElementById("contact-form") as HTMLFormElement);
  </script>
</MainLayout>

<style>
  .ct-head { padding-block: clamp(3rem, 7vw, 5rem) clamp(2rem, 4vw, 3rem); }
  .ct-head h1 { margin: 0 0 var(--space-5); font: 600 clamp(3.2rem, 9vw, 7.5rem)/.9 var(--serif); letter-spacing: -.045em; }
  .lede { max-width: 40rem; margin: 0; font: 400 clamp(1.1rem, 1.7vw, 1.35rem)/1.5 var(--serif); }

  .ct-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: clamp(2.5rem, 6vw, 6rem); padding-bottom: clamp(4.5rem, 9vw, 7rem); align-items: start; }
  @media (max-width: 900px) { .ct-grid { grid-template-columns: 1fr; } }

  /* Lane picker */
  .lanes-pick { border: 0; margin: 0 0 var(--space-7); padding: 0; }
  .lanes-pick legend { padding: 0; margin-bottom: var(--space-3); font-weight: 500; font-size: var(--text-md); }
  .pick-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); gap: var(--space-2); }
  .pick { position: relative; cursor: pointer; }
  .pick input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .pick-box { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) .9rem; border: 1px solid var(--surface-line); border-radius: 6px; background: var(--surface); transition: border-color .15s, background .15s, box-shadow .15s; }
  .pick-lane { --chip-size: 2rem; border-radius: .25rem; font-size: 1rem; transition: background .15s; }
  .pick-label { font-size: .92rem; line-height: 1.25; }
  .pick:hover .pick-box { border-color: var(--page-fg); }
  .pick input:checked + .pick-box { border-color: var(--track); background: var(--surface-raised); box-shadow: 0 0 0 1px var(--track); }
  .pick input:checked + .pick-box .pick-lane { --chip-bg: var(--track); --chip-fg: var(--on-accent); }
  .pick input[aria-invalid="true"] + .pick-box { border-color: var(--danger); box-shadow: 0 0 0 3px var(--danger-glow); }
  .pick input:focus-visible + .pick-box { outline: 2px solid var(--track); outline-offset: 2px; }

  /* Fields */
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  @media (max-width: 600px) { .row2 { grid-template-columns: 1fr; } }
  .field { margin-bottom: 1.1rem; }
  .field label { display: block; margin-bottom: .4rem; font-weight: 500; font-size: .92rem; }
  .req { color: var(--track-text); }
  .opt { margin-left: .3rem; font-size: var(--text-sm); font-weight: 400; color: var(--page-dim); }
  .field input, .field textarea {
    width: 100%; padding: .8rem .95rem; border: 1px solid var(--surface-line); border-radius: 6px; background: var(--surface);
    font: inherit; color: var(--page-fg); transition: border-color .15s, box-shadow .15s, background .15s;
  }
  .field textarea { resize: vertical; min-height: 9rem; }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--track); background: var(--surface-raised); box-shadow: 0 0 0 3px color-mix(in oklab, var(--track) 18%, transparent); }
  .field input::placeholder, .field textarea::placeholder { color: var(--placeholder); }
  .field.date input { max-width: 16rem; }
  .field input[aria-invalid="true"], .field textarea[aria-invalid="true"], .consent input[aria-invalid="true"] { border-color: var(--danger); box-shadow: 0 0 0 3px var(--danger-glow); }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .consent { display: flex; align-items: flex-start; gap: var(--space-3); margin: var(--space-2) 0 var(--space-6); font-size: .9rem; color: var(--page-fg-2); cursor: pointer; }
  .consent input { margin-top: .2rem; width: 1.05rem; height: 1.05rem; accent-color: var(--track); flex: none; }
  .consent a { color: var(--track-text); }

  .send { --btn-pad: 1.05rem var(--space-6); display: block; width: 100%; font: 500 1.05rem/1 var(--sans); cursor: pointer; }
  .send:disabled { opacity: .6; cursor: progress; }

  /* src/lib/contact/form.ts switches the class of #form-message */
  #form-message { margin-top: var(--space-4); padding: .8rem var(--space-4); border-radius: 6px; text-align: center; font-size: .9rem; }
  #form-message.hidden { display: none; }
  #form-message.success { color: var(--notice-ok-fg); background: var(--notice-ok-bg); }
  #form-message.error { color: var(--notice-error-fg); background: var(--notice-error-bg); }
  .note { padding: var(--space-4); border: 1px solid var(--surface-line); border-radius: 6px; }

  /* Side */
  .ct-side { border-top: 3px solid var(--page-fg); }
  .side-block { padding: 1.1rem 0; border-bottom: 1px solid var(--surface-line); }
  .side-label { margin: 0 0 .35rem; font-size: var(--text-md); line-height: 1.3; color: var(--page-dim); }
  .side-val { margin: 0; font-size: 1.05rem; }
  .side-note { margin: .3rem 0 0; font-size: .88rem; color: var(--page-dim); }
  .mail { font: italic 500 clamp(1.3rem, 2.4vw, 1.7rem)/1.2 var(--serif); color: var(--page-fg); text-decoration: none; border-bottom: 2px solid var(--track); }
  .mail:hover { color: var(--track-text); }
  .social { display: flex; gap: var(--space-5); }
  .social a { font-weight: 500; text-decoration: none; border-bottom: 1px solid currentColor; }
  .social a:hover { color: var(--track-text); }
</style>
